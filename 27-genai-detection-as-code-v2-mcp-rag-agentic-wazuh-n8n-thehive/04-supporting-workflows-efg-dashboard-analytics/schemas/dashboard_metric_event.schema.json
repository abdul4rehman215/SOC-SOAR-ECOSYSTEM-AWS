{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V2 Dashboard Metric Event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "metric_id",
    "window_start",
    "window_end",
    "metric_name",
    "metric_value",
    "generated_at"
  ],
  "properties": {
    "metric_id": {
      "type": "string"
    },
    "window_start": {
      "type": "string"
    },
    "window_end": {
      "type": "string"
    },
    "metric_name": {
      "type": "string"
    },
    "metric_value": {
      "type": "number"
    },
    "dimension_key": {
      "type": "string"
    },
    "dimension_value": {
      "type": "string"
    },
    "source_table": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
