<!--
  GenAI Detection-as-Code V2 - MCP action-path rules
  Custom rule ID layout:
    100300-100349 = MCP server/tool/resource runtime detections
  Install on Wazuh manager: /var/ossec/etc/rules/genai_mcp_rules.xml
-->
<group name="genai,mcp,agentic_ai,">

  <rule id="100300" level="0">
    <decoded_as>genai_mcp_json</decoded_as>
    <field name="event_source">^ai_demo_mcp_guardrail$</field>
    <field name="schema_version">^2\.0$</field>
    <description>GenAI MCP runtime telemetry event</description>
    <group>genai,mcp,mcp_base_event,</group>
  </rule>

  <rule id="100301" level="14">
    <if_sid>100300</if_sid>
    <field name="detection_family">^mcp_tool_poisoning$</field>
    <description>MCP tool poisoning or prompt injection via tool result detected for request $(request_id)</description>
    <group>genai,mcp,mcp_tool_poisoning,owasp_llm01,atlas_aml_t0051,</group>
  </rule>

  <rule id="100302" level="12">
    <if_sid>100300</if_sid>
    <field name="detection_family">^mcp_schema_drift$</field>
    <description>MCP tool schema or description drift detected for $(tool_name) on server $(mcp_server_name)</description>
    <group>genai,mcp,mcp_schema_drift,supply_chain,</group>
  </rule>

  <rule id="100303" level="12">
    <if_sid>100300</if_sid>
    <field name="detection_family">^mcp_overprivileged_tool$</field>
    <description>MCP over-privileged tool scope requested by $(tool_name) for request $(request_id)</description>
    <group>genai,mcp,mcp_overprivileged_tool,least_privilege,</group>
  </rule>

  <rule id="100304" level="15">
    <if_sid>100300</if_sid>
    <field name="detection_family">^mcp_sensitive_tool_without_hitl$</field>
    <description>Sensitive MCP tool invoked without valid human approval for request $(request_id)</description>
    <group>genai,mcp,mcp_sensitive_tool_without_hitl,hitl_missing,critical,</group>
  </rule>

  <rule id="100305" level="12">
    <if_sid>100300</if_sid>
    <field name="detection_family">^mcp_tool_argument_injection$</field>
    <description>MCP tool argument injection risk detected for $(tool_name) in request $(request_id)</description>
    <group>genai,mcp,mcp_tool_argument_injection,unsafe_tool_args,</group>
  </rule>

  <rule id="100306" level="14">
    <if_sid>100300</if_sid>
    <field name="detection_family">^mcp_resource_exfiltration$</field>
    <description>MCP resource exfiltration or resource-root violation detected for request $(request_id)</description>
    <group>genai,mcp,mcp_resource_exfiltration,data_exfiltration,critical,</group>
  </rule>

</group>
