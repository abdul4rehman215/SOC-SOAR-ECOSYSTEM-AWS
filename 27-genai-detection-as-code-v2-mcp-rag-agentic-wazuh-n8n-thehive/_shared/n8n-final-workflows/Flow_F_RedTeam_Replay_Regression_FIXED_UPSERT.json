      "parameters": {
        "jsCode": "let base = {};\ntry {\n  base = $('Code_Parse_Regression_Result').first().json || {};\n} catch (e) {\n  base = $json || {};\n}\nconst current = $json || {};\nconst srcRow = base.regression_run_row || base.row || base.monitor_event_row || {};\nconst now = new Date().toISOString();\nfunction str(v, d='') {\n  if (v === undefined || v === null) return d;\n  return String(v);\n}\nfunction num(v, d=0) {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : d;\n}\nfunction bool(v, d=false) {\n  if (typeof v === 'boolean') return v;\n  if (v === undefined || v === null || v === '') return d;\n  const s = String(v).toLowerCase();\n  return ['true','1','yes','y','pass','passed'].includes(s);\n}\nconst slackError = current.error?.message || current.error || '';\nconst row = {\n  regression_run_id: str(srcRow.regression_run_id || base.regression_run_id || `regression-${Date.now()}`),\n  started_at: str(srcRow.started_at || base.started_at || now),\n  completed_at: str(srcRow.completed_at || base.completed_at || now),\n  trigger_type: str(srcRow.trigger_type || base.trigger_type || 'webhook'),\n  repo: str(srcRow.repo || base.repo || '/opt/detection-ci/wazuh-genai-ci'),\n  commit_sha: str(srcRow.commit_sha || base.commit_sha || ''),\n  corpus_version: str(srcRow.corpus_version || base.corpus_version || ''),\n  total_tests: num(srcRow.total_tests ?? base.total_tests, 0),\n  passed_tests: num(srcRow.passed_tests ?? base.passed_tests, 0),\n  failed_tests: num(srcRow.failed_tests ?? base.failed_tests, 0),\n  expected_rule_misses: num(srcRow.expected_rule_misses ?? base.expected_rule_misses, 0),\n  unexpected_alerts: num(srcRow.unexpected_alerts ?? base.unexpected_alerts, 0),\n  alert_volume_before: num(srcRow.alert_volume_before ?? base.alert_volume_before, 0),\n  alert_volume_after: num(srcRow.alert_volume_after ?? base.alert_volume_after, 0),\n  regression_status: str(srcRow.regression_status || base.regression_status || base.decision || 'unknown'),\n  github_issue_url: str(srcRow.github_issue_url || base.github_issue_url || ''),\n  slack_notified: slackError ? false : bool(srcRow.slack_notified ?? base.slack_notified, true),\n  notes: str(srcRow.notes || base.notes || ''),\n  raw_result_json: str(srcRow.raw_result_json || base.raw_result_json || JSON.stringify(base))\n};\nreturn [{\n  json: {\n    ...base,\n    ...row,\n    row,\n    regression_run_row: row,\n    slack_error: str(slackError),\n    slack_notified: row.slack_notified\n  }\n}];"
