# Safe example only. Do not commit real tokens, webhooks, private keys, or passwords.
# Copy to /opt/detection-ci/wazuh-genai-ci/.env.ci on the n8n host and fill values locally.

# GitHub API / clone access
GITHUB_TOKEN="ghp_REPLACE_WITH_SCOPED_PAT_OR_USE_DEPLOY_KEY"

# Slack
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/REPLACE/REPLACE/REPLACE"

# Wazuh validation/deployment target
VALIDATION_WAZUH_MODE=remote_ssh
VALIDATION_WAZUH_HOST=172.31.0.10
VALIDATION_WAZUH_USER=root
VALIDATION_WAZUH_PORT=22
VALIDATION_SSH_KEY="/opt/detection-ci/wazuh-genai-ci/.runtime-ssh/n8n_to_wazuh_ed25519"
VALIDATION_WAZUH_RULES_DIR=/var/ossec/etc/rules
VALIDATION_WAZUH_DECODERS_DIR=/var/ossec/etc/decoders
VALIDATION_WAZUH_STAGING_DIR=/var/ossec/tmp/detection-ci
VALIDATION_WAZUH_RESTART_CMD="systemctl restart wazuh-manager"

DEPLOY_WAZUH_MODE=remote_ssh
DEPLOY_WAZUH_HOST=172.31.0.10
DEPLOY_WAZUH_USER=root
DEPLOY_WAZUH_PORT=22
DEPLOY_SSH_KEY="/opt/detection-ci/wazuh-genai-ci/.runtime-ssh/n8n_to_wazuh_ed25519"
DEPLOY_WAZUH_RULES_DIR=/var/ossec/etc/rules
DEPLOY_WAZUH_DECODERS_DIR=/var/ossec/etc/decoders
DEPLOY_WAZUH_STAGE_DIR=/var/ossec/tmp/deploy-flowb/stage
DEPLOY_WAZUH_BACKUP_DIR="/root/wazuh-flowb-backups"
DEPLOY_WAZUH_RESTART_CMD="systemctl restart wazuh-manager"

# Wazuh API / logtest values are lab placeholders.
WAZUH_API_URL="https://172.31.0.10:55000"
WAZUH_API_USERNAME="wazuh"
WAZUH_API_PASSWORD="REPLACE_WITH_LOCAL_SECRET"
WAZUH_API_VERIFY_TLS=false
