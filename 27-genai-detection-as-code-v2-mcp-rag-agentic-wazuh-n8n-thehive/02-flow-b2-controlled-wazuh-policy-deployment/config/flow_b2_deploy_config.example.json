{
  "repo_root": "/opt/detection-ci/wazuh-genai-ci",
  "wazuh_rules_dir": "/var/ossec/etc/rules",
  "wazuh_decoders_dir": "/var/ossec/etc/decoders",
  "wazuh_manager_service": "wazuh-manager",
  "policy_active_dir": "/opt/ai-demo-v2/policies",
  "backup_root": "/opt/detection-ci/backups/flow-b2",
  "staging_root": "/tmp/flow-b2-staging",
